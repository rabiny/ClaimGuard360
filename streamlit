# ---------------------------------------------------------
# DATA LOADING FUNCTION
# ---------------------------------------------------------

@st.cache_data(ttl=300)
def load_claim_data():
    query = """
        SELECT
            q.CLAIM_ID,
            q.PATIENT_ID,
            q.PROVIDER_ID,
            q.SERVICE_DATE,
            q.CITY,
            q.TOTAL_BILLED_AMOUNT,
            q.PROCEDURE_COUNT,
            q.RISK_SCORE,
            UPPER(q.RISK_CATEGORY) AS RISK_CATEGORY,
            q.PRIORITY,
            COALESCE(
                r.RISK_REASON,
                'No Risk Indicators'
            ) AS RISK_REASON
        FROM CLAIMGUARD_AI_360.ANALYTICS.INVESTIGATION_QUEUE q
        LEFT JOIN CLAIMGUARD_AI_360.AI.CLAIM_INVESTIGATION_REASON r
            ON q.CLAIM_ID = r.CLAIM_ID
        ORDER BY
            CASE q.PRIORITY
                WHEN 'P1' THEN 1
                WHEN 'P2' THEN 2
                WHEN 'P3' THEN 3
                ELSE 4
            END,
            q.RISK_SCORE DESC,
            q.TOTAL_BILLED_AMOUNT DESC
    """

    return session.sql(query).to_pandas()


